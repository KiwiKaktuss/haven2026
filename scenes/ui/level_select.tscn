[gd_scene format=3]
[ext_resource type="Theme" path="res://resources/ui/default_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/level_select.gd" id="script"]

[node name="LevelSelect" type="Control"]
texture_filter = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(1, 1, 1, 1)
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(520, 0)
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Content"]
text = "Choose a course"
theme_override_font_sizes/font_size = 34
mouse_filter = 2


[node name="Subtitle" type="Label" parent="Center/Content"]
text = "Four courses. Your own way through."
theme_override_font_sizes/font_size = 16
mouse_filter = 2


[node name="Course0" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "01    First Fairway"
alignment = 0

[node name="Course1" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "02    Cold Snap"
alignment = 0

[node name="Course2" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "03    Spring Works"
alignment = 0

[node name="Course3" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "04    Final Ascent"
alignment = 0

[node name="Back" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "Back"
