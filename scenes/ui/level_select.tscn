[gd_scene format=3]
[ext_resource type="Theme" path="res://resources/ui/default_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/level_select.gd" id="script"]
[ext_resource type="Script" path="res://scripts/ui/menu_background.gd" id="background"]
[ext_resource type="Texture2D" path="res://art/background2.png" id="sky"]

[ext_resource type="StyleBox" path="res://resources/ui/pixel/menu_panel.tres" id="menu_panel"]

[node name="LevelSelect" type="Control"]
texture_filter = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("background")
sky_only = true
sky_texture = ExtResource("sky")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="MenuPanel" type="Panel" parent="Center"]
custom_minimum_size = Vector2(584, 452)
layout_mode = 2
mouse_filter = 2
theme_override_styles/panel = ExtResource("menu_panel")

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(520, 0)
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Content"]
text = "Choose a course"
theme_override_font_sizes/font_size = 32
mouse_filter = 2
horizontal_alignment = 1


[node name="Subtitle" type="Label" parent="Center/Content"]
text = "Four courses. Your own way through."
theme_override_font_sizes/font_size = 16
mouse_filter = 2
horizontal_alignment = 1


[node name="Course0" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "01    First Fairway"
alignment = 0

[node name="Course1" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "02    Cold Snap"
alignment = 0

[node name="Course2" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "03    Spring Works"
alignment = 0

[node name="Course3" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "04    Final Ascent"
alignment = 0

[node name="Back" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(0, 48)
text = "Back"
