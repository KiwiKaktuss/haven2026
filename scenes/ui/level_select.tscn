[gd_scene format=3]
[ext_resource type="PackedScene" path="res://scenes/ui/course_tile.tscn" id="tile"]
[ext_resource type="Theme" path="res://resources/ui/default_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/level_select.gd" id="script"]
[ext_resource type="Script" path="res://scripts/ui/menu_background.gd" id="background"]
[ext_resource type="Texture2D" path="res://art/background2.png" id="sky"]

[ext_resource type="StyleBox" path="res://resources/ui/pixel/menu_panel.tres" id="menu_panel"]

[node name="LevelSelect" type="Control"]
texture_filter = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("background")
sky_only = true
sky_texture = ExtResource("sky")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="MenuPanel" type="Panel" parent="Center"]
custom_minimum_size = Vector2(696, 552)
layout_mode = 2
mouse_filter = 2
theme_override_styles/panel = ExtResource("menu_panel")

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(648, 0)
theme_override_constants/separation = 12

[node name="Heading" type="VBoxContainer" parent="Center/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Center/Content/Heading"]
layout_mode = 2
text = "Choose a level"
theme_override_font_sizes/font_size = 30
mouse_filter = 2
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="Center/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
columns = 2

[node name="Course0" parent="Center/Content/Grid" instance=ExtResource("tile")]
layout_mode = 2

[node name="Course1" parent="Center/Content/Grid" instance=ExtResource("tile")]
layout_mode = 2

[node name="Course2" parent="Center/Content/Grid" instance=ExtResource("tile")]
layout_mode = 2

[node name="Course3" parent="Center/Content/Grid" instance=ExtResource("tile")]
layout_mode = 2

[node name="Back" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(156, 36)
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_focus_color = Color(0.17, 0.18, 0.24, 1)
text = "Back"
mouse_default_cursor_shape = 2
