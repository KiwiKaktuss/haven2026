[gd_scene format=3]
[ext_resource type="Theme" path="res://resources/ui/default_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/deck_editor.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/ui/card_view.tscn" id="card"]

[node name="DeckEditor" type="Control"]
texture_filter = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(1, 1, 1, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Margin/Content"]


[node name="Title" type="Label" parent="Margin/Content/Header"]
text = "Your deck"
theme_override_font_sizes/font_size = 32
mouse_filter = 2
size_flags_horizontal = 3

[node name="Count" type="Label" parent="Margin/Content/Header"]
text = "6 / 6 selected"
theme_override_font_sizes/font_size = 16
mouse_filter = 2


[node name="Grid" type="GridContainer" parent="Margin/Content"]
columns = 5
size_flags_vertical = 3
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Card0" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card1" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card2" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card3" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card4" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card5" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card6" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card7" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card8" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card9" parent="Margin/Content/Grid" instance=ExtResource("card")]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Footer" type="HBoxContainer" parent="Margin/Content"]
theme_override_constants/separation = 24

[node name="Hint" type="Label" parent="Margin/Content/Footer"]
text = "Select six cards. Numbers show elixir cost."
theme_override_font_sizes/font_size = 14
mouse_filter = 2
size_flags_horizontal = 3

[node name="Done" type="Button" parent="Margin/Content/Footer"]
custom_minimum_size = Vector2(0, 48)
text = "Save deck"
custom_minimum_size = Vector2(160, 48)
