[gd_scene format=3]
[ext_resource type="StyleBox" path="res://resources/ui/pixel/info.tres" id="frame"]
[ext_resource type="Theme" path="res://resources/ui/default_theme.tres" id="theme"]

[node name="CardInfo" type="PanelContainer"]
top_level = true
visible = false
texture_filter = 2
custom_minimum_size = Vector2(420, 60)
offset_right = 420.0
offset_bottom = 60.0
mouse_filter = 2
theme = ExtResource("theme")
theme_override_styles/panel = ExtResource("frame")
z_index = 100

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 3

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 14

[node name="Description" type="Label" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2
autowrap_mode = 2
theme_override_font_sizes/font_size = 12
